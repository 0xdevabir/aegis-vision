# =============================================================
# AI Smart Surveillance System (Aegis) — Environment Variables
# =============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# --- Database ---
# Local zero-setup (recommended when Postgres/Docker is unavailable):
USE_SQLITE=true
DATABASE_URL=sqlite:///./data/ai_sss.db
ALLOW_SQLITE_FALLBACK=true
# Local Postgres:
# USE_SQLITE=false
# DATABASE_URL=postgresql://surveillance:surveillance@localhost:5432/surveillance_db
# Render:
# DATABASE_URL=postgresql://USER:PASS@HOST/DB

POSTGRES_DB=surveillance_db
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_64_CHARS_MIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Encryption ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_32_CHARS
ENCRYPTION_SALT=CHANGE_THIS_SALT_16_CHARS_MIN

# --- Alert Webhooks (optional) ---
ALERTS_ENABLED=false
LAW_ENFORCEMENT_WEBHOOK=
EMERGENCY_WEBHOOK=
SECURITY_TEAM_WEBHOOK=
SMS_WEBHOOK=
CAD_WEBHOOK=
RADIO_WEBHOOK=

# --- HA / Redis (optional; docker-compose includes redis) ---
REDIS_URL=

# --- Recording / VMS ---
CLIP_COOLDOWN_SECONDS=15
# Red-alert capture basket: zoomed still of the subject while a critical alert is live
CAPTURE_ENABLED=true
# false = cameras stay off at launch until started on the Live page
CAMERA_AUTOSTART=false
CAPTURE_INTERVAL_SECONDS=5
CAPTURE_RETENTION_DAYS=7
# Follow a red-alert person from camera to camera by appearance (models/person_reid_youtu_2021nov.onnx)
XCAM_TRACKING_ENABLED=true
# How alike two sightings must look (0-1). Higher = fewer wrong matches, more misses
XCAM_MATCH_THRESHOLD=0.7
# Stop following someone not seen for this many seconds
XCAM_TTL_SECONDS=900
PIPELINE_STREAM_ENABLED=true
STREAM_FPS=30
STREAM_WIDTH=1280
STREAM_QUALITY=80       # JPEG quality of the dashboard stream
STREAM_HUD=clean        # clean = people marked only; full = whole HUD (face panels, radar, bars)

# --- Camera (for Docker / pipeline) ---
CAMERA_INDEX=0
# RTSP URLs (use in cameras.yaml as ${RTSP_GATE_1} etc.)
RTSP_GATE_1=rtsp://user:password@192.168.0.100:554/stream1
RTSP_PARKING_1=rtsp://user:password@192.168.0.101:554/stream1
RTSP_LOBBY_1=rtsp://user:password@192.168.0.102:554/stream1
RTSP_TRANSPORT=tcp

# --- Pipeline ↔ Backend integration ---
BACKEND_URL=http://localhost:8000
INTERNAL_API_KEY=CHANGE_THIS_INTERNAL_API_KEY
PIPELINE_EVENTS_ENABLED=true
AUTO_ALERTS_ENABLED=true
HEARTBEAT_INTERVAL=5

# --- Live dashboard video (pipeline → backend MJPEG) ---
PIPELINE_STREAM_ENABLED=true
STREAM_FPS=30
STREAM_WIDTH=1280

# --- Continuous DVR (24/7 segment recording) ---
DVR_ENABLED=true
DVR_SEGMENT_SECONDS=60
DVR_FPS=8
DVR_WIDTH=960
DVR_RETENTION_HOURS=48

# --- ONVIF PTZ (optional physical camera control) ---
ONVIF_TIMEOUT=3
# ONVIF_GATE_1_HOST=192.168.0.100
# ONVIF_GATE_1_USER=admin
# ONVIF_GATE_1_PASS=password

# --- Runtime ---
ENVIRONMENT=development

# --- Performance ---
PERF_MONITOR=false
HEADLESS=false

# --- Docker (./scripts/docker-up.sh  or  make docker-up) ---
# Port the dashboard is published on
HTTP_PORT=8080
# First-start admin account. Leave empty to have one generated and printed in `docker compose logs backend`.
ADMIN_PASSWORD=
# Demo only: a "Use the demo account" button on the sign-in page. Setting a password here creates
# that account at start-up AND builds the password into the dashboard, so anyone who can open the
# dashboard can sign in. Leave empty anywhere other people can reach. Rebuild after changing.
DEMO_LOGIN_USERNAME=demo
DEMO_LOGIN_PASSWORD=
DEMO_LOGIN_ROLE=admin
# Must be set for compose (the database user password inside the stack)
# POSTGRES_PASSWORD is defined above.
# Optional: run the CV pipeline on one video file instead of cameras.yaml
# PIPELINE_VIDEO=data/demo/clips/sample.mp4
# Optional: host webcam bridge URL used when a camera source is 0 / "0"
# LOCAL_CAMERA_URL=http://host.docker.internal:8090/video


# Optional: bearer token Prometheus uses to scrape /api/v1/metrics (admin login works without it)
METRICS_TOKEN=
# Optional: sign outbound webhooks (X-Aegis-Signature = sha256 HMAC of "<X-Aegis-Timestamp>.<body>")
WEBHOOK_SIGNING_SECRET=
